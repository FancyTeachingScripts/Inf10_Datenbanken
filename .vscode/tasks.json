{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-single-tex",
            "type": "shell",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "lualatex -interaction=nonstopmode main.tex; lualatex -interaction=nonstopmode main.tex"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "lualatex -interaction=nonstopmode main.tex; lualatex -interaction=nonstopmode main.tex"
                ]
            }
        },
        {
            "label": "build-all-main-tex",
